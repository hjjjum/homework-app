rules_version = '2';

// ---------------------------------------------------------------------------
// 이 앱이 사용하는 경로에만 읽기/쓰기를 허용하는 최소 규칙 초안.
// 로그인(익명 포함) 여부와 관계없이 동작합니다.
//
// ⚠️ 주의: 아래 경로를 아는 사람은 누구나 읽고 쓸 수 있습니다.
//    가족끼리 쓰는 앱이라 지금은 이렇게 두지만, 나중에 익명 인증을
//    필수로 만들려면 각 allow 앞에 `request.auth != null &&` 를 붙이세요.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // students/{studentId} — 문서 자체는 쓰지 않지만 경로 제한을 위해 정의
    match /students/{studentId} {

      // daughter1, daughter2 두 개만 허용
      function isKnownStudent() {
        return studentId in ['daughter1', 'daughter2'];
      }

      allow read: if isKnownStudent();
      allow write: if false;   // 학생 문서 자체는 만들거나 고치지 않음

      // students/{studentId}/todos/{todoId}
      match /todos/{todoId} {

        function isValidTodo(d) {
          return d.keys().hasOnly(
                   ['title', 'category', 'completed', 'date',
                    'memo', 'addedBy', 'source', 'subject', 'items', 'urgent',
                    'imageId', 'createdAt', 'updatedAt'])
              && d.keys().hasAll(['title', 'category', 'completed'])
              && d.title is string
              // 학원 알림장을 통째로 담는 경우가 있어 넉넉히 둔다
              && d.title.size() > 0 && d.title.size() <= 2000
              && d.category in ['숙제', '개인스케줄', '공부']
              && d.completed is bool
              && (!('date' in d) || (d.date is string && d.date.size() <= 30))
              && (!('memo' in d) || (d.memo is string && d.memo.size() <= 1000))
              && (!('addedBy' in d) || d.addedBy in ['mom', 'self'])
              // source = 어떤 입력 방식으로 들어왔는지. 새 입력 소스가 추가돼도
              // 규칙을 다시 배포하지 않도록 값 목록 대신 타입/길이만 본다.
              && (!('source' in d) || (d.source is string && d.source.size() <= 40))
              && (!('subject' in d)
                  || d.subject in ['수학', '영어', '과학', '국어', '사회', '기타'])
              // 세부 항목: [{text, done}] 배열. 개수만 제한하고 내부는 앱이 정리한다.
              && (!('items' in d) || (d.items is list && d.items.size() <= 50))
              // 급한 일 표시
              && (!('urgent' in d) || d.urgent is bool)
              // 캡쳐로 만든 숙제의 원본 사진 id (students/{studentId}/images/{imageId})
              && (!('imageId' in d) || (d.imageId is string && d.imageId.size() <= 40))
              && (!('createdAt' in d) || d.createdAt is timestamp)
              && (!('updatedAt' in d) || d.updatedAt is timestamp);
        }

        allow read:   if isKnownStudent();
        allow create: if isKnownStudent() && isValidTodo(request.resource.data);
        allow update: if isKnownStudent() && isValidTodo(request.resource.data);
        allow delete: if isKnownStudent();
      }

      // students/{studentId}/images/{imageId}
      // 캡쳐로 숙제를 만들 때 남겨 두는 원본 사진 (JPEG data URL). 화면에서 "펼치기"로 본다.
      // 한 번 저장하면 고치지 않는다. 문서 한도(1MB) 안에 들도록 앱이 줄여서 올린다.
      match /images/{imageId} {
        function isValidImage(d) {
          return d.keys().hasOnly(['data', 'createdAt'])
              && d.data is string && d.data.size() > 0 && d.data.size() <= 900000
              && d.createdAt is timestamp;
        }

        allow read:   if isKnownStudent();
        allow create: if isKnownStudent() && isValidImage(request.resource.data);
        allow update: if false;
        allow delete: if isKnownStudent();
      }

      // students/{studentId}/push/{subId}
      // 저녁 알림을 받을 기기 주소. 보내는 쪽(GitHub Actions)이 여기를 읽어 알림을 보낸다.
      // 주소가 노출돼도 VAPID 비밀 키 없이는 알림을 보낼 수 없다.
      match /push/{subId} {
        function isValidSub(d) {
          return d.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'label', 'at'])
              && d.endpoint is string && d.endpoint.size() > 10 && d.endpoint.size() <= 500
              && d.p256dh is string && d.p256dh.size() > 0 && d.p256dh.size() <= 200
              && d.auth is string && d.auth.size() > 0 && d.auth.size() <= 100
              && (!('label' in d) || (d.label is string && d.label.size() <= 40))
              && d.at is timestamp;
        }

        allow read:   if isKnownStudent();
        allow create: if isKnownStudent() && isValidSub(request.resource.data);
        allow update: if isKnownStudent() && isValidSub(request.resource.data);
        allow delete: if isKnownStudent();
      }

      // students/{studentId}/meta/{docId}
      // cheer  = 엄마의 응원 한마디 (오늘 하루만 띄운다)
      // profile = 화면 제목에 쓰는 이름과 아이콘
      // 둘 다 할일이 아니라서 todos와 분리해 둔다.
      match /meta/{docId} {

        function isValidCheer(d) {
          return d.keys().hasOnly(['text', 'at'])
              && d.text is string && d.text.size() > 0 && d.text.size() <= 100
              && d.at is timestamp;
        }

        function isValidProfile(d) {
          return d.keys().hasOnly(['name', 'icon', 'at'])
              && d.name is string && d.name.size() > 0 && d.name.size() <= 20
              // icon은 stickers.js의 id. 스티커가 늘어도 규칙을 다시 배포하지
              // 않도록 값 목록 대신 타입과 길이만 본다.
              && d.icon is string && d.icon.size() > 0 && d.icon.size() <= 30
              && d.at is timestamp;
        }

        // 학원 요일: [{subject, days:[0~6], name}] — 안쪽 값은 앱이 정리하므로
        // 여기서는 개수와 타입만 본다 (학원이 늘어도 규칙을 다시 배포하지 않도록).
        function isValidSchedule(d) {
          return d.keys().hasOnly(['items', 'at'])
              && d.items is list && d.items.size() <= 20
              && d.at is timestamp;
        }

        // 연속 달성 기록. 기기를 바꿔도 남도록 Firestore에 둔다.
        // board(스티커 판)는 아직 기기에만 두지만, 나중에 옮길 때 규칙을 다시
        // 배포하지 않도록 여기서 미리 받아 둔다.
        function isValidStreak(d) {
          return d.keys().hasOnly(['streak', 'best', 'lastClearDate', 'board', 'resetAt', 'at'])
              && d.streak is int && d.streak >= 0 && d.streak <= 10000
              && d.best is int && d.best >= 0 && d.best <= 10000
              && (!('lastClearDate' in d)
                  || (d.lastClearDate is string && d.lastClearDate.size() <= 10))
              && (!('board' in d) || (d.board is list && d.board.size() <= 50))
              // resetAt = "여기서부터 다시 세라"는 표시. 기기가 이 표시를 처음 보면
              // 자기 기록을 버리고 이 값을 그대로 따른다 (엄마가 0부터 다시 시작시킬 때).
              && (!('resetAt' in d) || (d.resetAt is string && d.resetAt.size() <= 40))
              && d.at is timestamp;
        }

        function isValidMeta(d) {
          return (docId == 'cheer' && isValidCheer(d))
              || (docId == 'profile' && isValidProfile(d))
              || (docId == 'schedule' && isValidSchedule(d))
              || (docId == 'streak' && isValidStreak(d));
        }

        allow read:   if isKnownStudent();
        allow create: if isKnownStudent() && isValidMeta(request.resource.data);
        allow update: if isKnownStudent() && isValidMeta(request.resource.data);
        // 지우기도 열어 둔다. 예전에는 write 하나로 묶여 있어 지울 수가 없었는데,
        // 잘못 들어간 값(시험 삼아 넣은 기록 등)을 치우지 못하면 덮어쓰는 수밖에 없다.
        // 어차피 같은 사람이 내용을 바꿀 수는 있으므로 지우기를 막는다고 더 안전해지지 않는다.
        allow delete: if isKnownStudent();
      }
    }

    // 그 밖의 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
